# Образец переменных. Настоящие значения лежат ВНЕ репозитория: /opt/wms-constructor-secrets/app.env (права 600).
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=constructor_ro
MSSQL_PASSWORD=
MSSQL_DB=LV_MERIDIAN
MSSQL_EXCHANGE_DB=MRDN_Exchange
# yes - доверять сертификату сервера (самоподписанный); no - строгая проверка
MSSQL_TRUST_CERT=yes
ROW_LIMIT_UI=5000
ROW_LIMIT_XLSX=100000
QUERY_TIMEOUT=60
